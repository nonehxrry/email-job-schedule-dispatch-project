# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/reachinbox_db?schema=public"

# Redis Connection (BullMQ & Rate Limiter)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Elasticsearch Connection
ELASTICSEARCH_NODE=http://localhost:9200

# Authentication (JWT & Google OAuth)
JWT_SECRET=reachinbox_dev_jwt_secret_key_change_in_production_2026
GOOGLE_CLIENT_ID=mock_google_client_id_for_dev

# Slack Integration (OAuth & Webhook Alerts)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:5000/api/slack/oauth_callback
SLACK_DEFAULT_WEBHOOK_URL=

# Scheduler & Throttling Defaults
DEFAULT_SENDER_EMAIL=outreach@reachinbox.ai
DEFAULT_SENDER_NAME=ReachInbox SDR
WORKER_CONCURRENCY=5
EMAIL_SEND_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=50
